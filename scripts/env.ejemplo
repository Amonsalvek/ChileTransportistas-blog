# Copia este archivo a .env en la RAÍZ del repo (.env no se versiona) y
# completa los valores. scripts/portada.mjs lo lee solo.
#
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Opcional: modelo de imágenes (por defecto gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Cloudflare R2: dashboard → R2 → Manage R2 API Tokens → Create API token
# con permiso "Object Read & Write" solo sobre el bucket imagenes-chiletransportistas.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcionales (estos son los valores por defecto):
# R2_BUCKET=imagenes-chiletransportistas
# R2_PREFIX=ChileTransportistas-assets/Blog/
# CDN_BASE=https://cdn.chiletransportistas.com
